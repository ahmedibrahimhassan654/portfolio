# Copy this file to `.env` and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the client.

# Your WhatsApp link. Use the full international format, no +, no spaces.
# Egypt country code (20) + number without the leading 0.
# Example: 01501158003  ->  https://wa.me/201501158003
#
# Do NOT use a wa.link short URL here: it redirects and drops the `?text=`
# pre-filled message appended by src/data/portfolio.ts. Use the resolved
# wa.me link instead.
VITE_WHATSAPP_URL=https://wa.me/201501158003

# Optional: pre-filled message when the WhatsApp chat opens
VITE_WHATSAPP_MESSAGE=Hello Ahmed, I found your portfolio and would like to talk.
